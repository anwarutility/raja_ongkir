<odoo>
  <data>

    <record id="subdistrict_list" model="ir.ui.view">
      <field name="name">Subdistrict List</field>
      <field name="model">res.city.subdistrict</field>
      <field name="arch" type="xml">
        <tree editable="bottom" duplicate="false">
          <field name="name"/>
          <field name="city_rel"/>
          <field name="province_id"/>
          <field name="city_id"/>
          <field name="subdistrict_id"/>
        </tree>
      </field>
    </record>

    <record id="subdistrict_list_menu_window" model="ir.actions.act_window">
      <field name="name">Subdistrict</field>
      <field name="res_model">res.city.subdistrict</field>
      <field name="type">ir.actions.act_window</field>
      <field name="view_mode">tree</field>
    </record>

    <menuitem id="subdistrict_rajaongkir_menu"
              name="Subdistrict"
              parent="menu_rajaongkir_config"
              action="subdistrict_list_menu_window"
              sequence="4"/>

  </data>
</odoo>